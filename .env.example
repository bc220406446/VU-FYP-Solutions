# ==============================================================================
# DeveloperBano - Environment Variables Template
# ==============================================================================

# Supabase Configuration
# Required for database queries and Supabase Storage integration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Privileged Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile (Spam Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
